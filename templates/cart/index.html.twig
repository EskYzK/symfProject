{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
    <h1 class="my-4">Votre Panier</h1>

    {% if items|length > 0 %}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix</th>
                    <th>Quantité</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.product.name }}</td>
                        <td>{{ item.product.price }} €</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.product.price * item.quantity }} €</td>
                        <td>
                            <a href="{{ path('cart_remove', {'id': item.product.id}) }}" class="btn btn-danger btn-sm">
                                Supprimer
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end"><strong>Total :</strong></td>
                    <td colspan="2"><strong>{{ total }} €</strong></td>
                </tr>
            </tfoot>
        </table>
        
        <div class="d-flex justify-content-end align-items-center mt-3">
            <a href="{{ path('product_index') }}" class="btn btn-secondary me-3">
                <i class="fas fa-arrow-left"></i> Continuer mes achats
            </a>
            
            {# Le bouton Payer #}
            <a href="{{ path('order_add') }}" class="btn btn-success btn-lg">
                <i class="fas fa-check"></i> Payer {{ total }} €
            </a>
        </div>
        
    {% else %}
        <div class="alert alert-warning">Votre panier est vide.</div>
        <a href="{{ path('product_index') }}" class="btn btn-primary">Voir les produits</a>
    {% endif %}
{% endblock %}