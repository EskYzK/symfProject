{% extends 'base.html.twig' %}

{% block title %}Votre Panier{% endblock %}

{% block body %}
    <h1>Votre Panier</h1>

    {% if items|length > 0 %}
        <table class="table">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix</th>
                    <th>Quantité</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.product.name }}</td>
                        <td>{{ item.product.price }} €</td>
                        <td>
                            <a href="{{ path('cart_remove', {id: item.product.id}) }}" class="btn btn-sm btn-secondary">-</a>
                            {{ item.quantity }}
                            <a href="{{ path('cart_add', {id: item.product.id}) }}" class="btn btn-sm btn-secondary">+</a>
                        </td>
                        <td>{{ item.product.price * item.quantity }} €</td>
                        <td>
                            <a href="{{ path('cart_delete', {id: item.product.id}) }}" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right"><strong>Total :</strong></td>
                    <td>{{ total }} €</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <div>
            <a href="{{ path('cart_clear') }}" class="btn btn-warning">Vider le panier</a>
            <a href="{{ path('order_create') }}" class="btn btn-success">Passer la commande</a>
        </div>

    {% else %}
        <p>Votre panier est vide.</p>
    {% endif %}
{% endblock %}
