<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        {% endblock %}

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <div class="container-fluid">
                    <a class="navbar-brand" href="{{ path('home') }}">GameO'Center</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('product_index') }}">{{ 'header.products'|trans }}</a>
                        </li>
                        {% if app.user %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('cart_index') }}">
                                    <i class="fas fa-shopping-cart"></i> {{ 'header.cart'|trans }}
                                </a>
                            </li>
                        {% endif %}
                        <li class="nav-item">
                            {% if app.user %}
                                <a class="nav-link" href="{{ path('app_account') }}">{{ 'header.account'|trans }}</a>
                            {% else %}
                                <a class="nav-link" href="{{ path('app_login') }}">{{ 'header.login'|trans }}</a>
                            {% endif %}
                        </li>
                    </ul>
                    {# ms-auto permet de pousser tout ce bloc vers la droite #}
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item mx-2 border-end d-none d-lg-block" style="height: 20px; border-color: #ccc;"></li>
                        <li class="nav-item d-flex align-items-center gap-2">
                            <a class="nav-link p-1" href="{{ path('change_locale', {locale: 'fr'}) }}" title="Français" style="font-size: 1.2rem;">🇫🇷</a>
                            <a class="nav-link p-1" href="{{ path('change_locale', {locale: 'ja'}) }}" title="日本語" style="font-size: 1.2rem;">🇯🇵</a>
                        </li>
                    </ul>
                </div>
                </div>
            </nav>
        </header>
        <div class="container">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>