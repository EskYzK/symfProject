{% extends 'base.html.twig' %}

{% block title %}{{ 'orderpage.header'|trans }}{% endblock %}

{% block body %}
<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">
        <div class="card-body p-5">
            <div class="mb-4">
                <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
            </div>
            
            <h1 class="h2 mb-3">{{ 'orderpage.thanks'|trans }}</h1>
            <p class="text-muted mb-4">
                
            </p>

            <div class="alert alert-light border">
                <strong>{{ 'orderpage.order'|trans }}</strong> <span class="text-primary">{{ order.reference }}</span><br>
                <strong>{{ 'orderpage.price'|trans }}</strong> {{ order.total }} €
            </div>

            <div class="d-grid gap-2 d-sm-flex justify-content-center mt-4">
                <a href="{{ path('app_account') }}" class="btn btn-primary px-4">
                    {{ 'orderpage.list'|trans }}
                </a>
                <a href="{{ path('product_index') }}" class="btn btn-outline-secondary px-4">
                    {{ 'orderpage.return'|trans }}
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}