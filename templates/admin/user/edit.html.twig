{% extends 'base.html.twig' %}

{% block title %}{{ 'useredit.header' |trans }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>{{ 'useredit.title' |trans }} <small class="text-muted">{{ user.email }}</small></h1>
    <hr>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-user-shield"></i> {{ 'useredit.roles' |trans }}
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        {{ form_row(form.roles) }}
                        
                        <div class="alert alert-info mt-3">
                            <small><i class="fas fa-info-circle"></i> {{ 'useredit.note' |trans }}</small>
                        </div>

                        <button class="btn btn-success mt-3 w-100">
                            <i class="fas fa-save"></i> {{ 'useredit.save' |trans }}
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    {{ 'useredit.persinfo' |trans }}
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>{{ 'useredit.firstname' |trans }}</strong> {{ user.firstname }}
                    </li>
                    <li class="list-group-item">
                        <strong>{{ 'useredit.lastname' |trans }}</strong> {{ user.lastname }}
                    </li>
                    <li class="list-group-item">
                        <strong>{{ 'useredit.email' |trans }}</strong> <a href="mailto:{{ user.email }}">{{ user.email }}</a>
                    </li>
                    <li class="list-group-item">
                        <strong>ID :</strong> #{{ user.id }}
                    </li>
                </ul>
            </div>
        </div>
    </div>
    
    <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary mt-4">
        <i class="fas fa-arrow-left"></i> {{ 'useredit.return' |trans }}
    </a>
</div>
{% endblock %}