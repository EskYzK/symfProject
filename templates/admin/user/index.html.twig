{% extends 'base.html.twig' %}

{% block title %}{{ 'userindex.title' | trans}}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h1>👥 {{ 'userindex.title' | trans}}</h1>
        <a href="{{ path('admin_user_new') }}" class="btn btn-primary">
            <i class="fas fa-user-plus"></i> {{ 'userindex.new' | trans}}
        </a>
    </div>
    <table class="table table-striped table-hover mt-4">
        <thead>
            <tr>
                <th>ID</th>
                <th>{{ 'userindex.email' | trans}}</th>
                <th>{{ 'userindex.fullname' | trans}}</th>
                <th>{{ 'userindex.roles' | trans}}</th>
                <th>{{ 'userindex.actions' | trans}}</th>
            </tr>
        </thead>
        <tbody>
        {% for user in pagination %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.firstname }} {{ user.lastname }}</td>
                <td>
                    {% for role in user.roles %}
                        {% if role == 'ROLE_ADMIN' %}
                            <span class="badge bg-danger">{{ 'userroles.admin' | trans }}</span>
                        {% else %}
                            <span class="badge bg-primary">{{ 'userroles.user' | trans }}</span>
                        {% endif %}
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-warning" title="{{ 'userindex.edit' | trans }}">
                        <i class="fas fa-user-edit"></i> {{ 'userindex.edit' | trans }}
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">{{ 'userindex.nouser' | trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>
{% endblock %}