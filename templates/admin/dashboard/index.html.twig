{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.header'|trans }}{% endblock %}

{% block body %}
<div class="container-fluid my-4">
    <div class="row">
        <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
            <div class="position-sticky pt-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold" href="{{ path('admin_dashboard') }}">
                            <i class="fas fa-home"></i> {{ 'dashboard.title'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin_product_index') }}">
                            <i class="fas fa-box"></i> {{ 'dashboard.cat1'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin_order_index') }}">
                            <i class="fas fa-shopping-bag"></i> {{ 'dashboard.cat2'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin_user_index') }}">
                            <i class="fas fa-users"></i> {{ 'dashboard.cat3'|trans }}
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">{{ 'dashboard.title'|trans }}</h1>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card text-white bg-primary mb-3">
                        <div class="card-header">{{ 'dashboard.tile1'|trans }}</div>
                        <div class="card-body">
                            <h3 class="card-title">{{ totalSales }} €</h3>
                            <p class="card-text">{{ 'dashboard.desctile1'|trans }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-white bg-success mb-3">
                        <div class="card-header">{{ 'dashboard.tile2'|trans }}</div>
                        <div class="card-body">
                            <h3 class="card-title">{{ inStock }} / {{ countProducts }}</h3>
                            <p class="card-text">{{ 'dashboard.desctile2'|trans }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-white bg-danger mb-3">
                        <div class="card-header">{{ 'dashboard.tile3'|trans }}</div>
                        <div class="card-body">
                            <h3 class="card-title">{{ outOfStock }}</h3>
                            <p class="card-text">{{ 'dashboard.desctile3'|trans }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <h2>{{ 'dashboard.history'|trans }}</h2>
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>{{ 'dashboard.reference'|trans }}</th>
                            <th>{{ 'dashboard.date'|trans }}</th>
                            <th>{{ 'dashboard.client'|trans }}</th>
                            <th>{{ 'dashboard.price'|trans }}</th>
                            <th>{{ 'dashboard.status'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in lastOrders %}
                            <tr>
                                <td>{{ order.reference }}</td>
                                <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                <td>{{ order.user.email }}</td>
                                <td>{{ order.total }} €</td>
                                <td><span class="badge {{ status_classes[order.status] ?? 'bg-secondary' }}">
                                        {{ ('orderstatus.' ~ order.status)|trans }}
                                    </span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center">{{ 'dashboard.noorder'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>
{% endblock %}