{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
<div class="container-fluid my-4">
    <div class="row">
        {# --- MENU LATÉRAL (Sidebar) --- #}
        <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
            <div class="position-sticky pt-3">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold" href="{{ path('admin_dashboard') }}">
                            <i class="fas fa-home"></i> Tableau de bord
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-box"></i> Produits
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-shopping-bag"></i> Commandes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-users"></i> Utilisateurs
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        {# --- CONTENU PRINCIPAL --- #}
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Tableau de Bord</h1>
            </div>

            {# --- CARTES STATS --- #}
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card text-white bg-primary mb-3">
                        <div class="card-header">Chiffre d'affaires</div>
                        <div class="card-body">
                            <h3 class="card-title">{{ totalSales }} €</h3>
                            <p class="card-text">Total des commandes payées</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-white bg-success mb-3">
                        <div class="card-header">Produits en stock</div>
                        <div class="card-body">
                            <h3 class="card-title">{{ inStock }} / {{ countProducts }}</h3>
                            <p class="card-text">Produits disponibles à la vente</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-white bg-danger mb-3">
                        <div class="card-header">Ruptures de stock</div>
                        <div class="card-body">
                            <h3 class="card-title">{{ outOfStock }}</h3>
                            <p class="card-text">Produits à réapprovisionner</p>
                        </div>
                    </div>
                </div>
            </div>

            {# --- TABLEAU DERNIÈRES COMMANDES --- #}
            <h2>Dernières commandes</h2>
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Réf</th>
                            <th>Date</th>
                            <th>Client</th>
                            <th>Montant</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in lastOrders %}
                            <tr>
                                <td>{{ order.reference }}</td>
                                <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                <td>{{ order.user.email }}</td>
                                <td>{{ order.total }} €</td>
                                <td><span class="badge bg-secondary">{{ order.status }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center">Aucune commande pour le moment.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</div>
{% endblock %}