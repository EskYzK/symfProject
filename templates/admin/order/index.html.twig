{% extends 'base.html.twig' %}

{% block title %}{{ 'orderadmin.title'|trans }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>🛍️ {{ 'orderadmin.title'|trans }}</h1>

    <table class="table table-striped table-hover mt-4">
        <thead>
            <tr>
                <th>Réf</th>
                <th>{{ 'orderadmin.date'|trans }}</th>
                <th>{{ 'orderadmin.client'|trans }}</th>
                <th>{{ 'orderadmin.price'|trans }}</th>
                <th>{{ 'orderadmin.status'|trans }}</th>
                <th>{{ 'orderadmin.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for order in pagination %}
            <tr>
                <td>{{ order.reference }}</td>
                <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                <td>{{ order.user.email }}</td>
                <td class="fw-bold">{{ order.total }} €</td>
                <td>
                    {% if order.status == 'payee' %}
                        <span class="badge bg-success">Payée</span>
                    {% else %}
                        <span class="badge bg-secondary">{{ order.status }}</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('admin_order_show', {'id': order.id}) }}" class="btn btn-sm btn-info text-white">
                        <i class="fas fa-eye"></i> Voir
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">{{ 'orderadmin.noproduct'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>
{% endblock %}