{% extends 'base.html.twig' %}

{% block title %}{{ 'productlist.title'|trans }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📦 {{ 'productlist.title'|trans }}</h1>
        <a href="{{ path('admin_product_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> {{ 'productlist.new'|trans }}
        </a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>{{ 'productlist.name'|trans }}</th>
                <th>{{ 'productlist.price'|trans }}</th>
                <th>{{ 'productlist.stock'|trans }}</th>
                <th>{{ 'productlist.status'|trans }}</th>
                <th>{{ 'productlist.actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
        {% for product in pagination %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.name }}</td>
                <td>{{ product.price }} €</td>
                <td>
                    <span class="badge {{ product.stock > 0 ? 'bg-success' : 'bg-danger' }}">
                        {{ product.stock }}
                    </span>
                </td>
                <td>
                    {% set status_classes = {
                        'AVAILABLE': 'bg-success',
                        'OUT_OF_STOCK': 'bg-danger',
                        'PRE_ORDER': 'bg-warning'
                    } %}
                    <span class="badge {{ status_classes[product.status.value] ?? 'bg-secondary' }}">
                        {{ ('productstatus.' ~ product.status.value)|trans }}
                    </span>
                </td> 
                <td>
                    <a href="{{ path('admin_product_edit', {'id': product.id}) }}" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i>
                    </a>
                    
                    <form method="post" action="{{ path('admin_product_delete', {'id': product.id}) }}" style="display: inline-block" onsubmit="return confirm('Êtes-vous sûr ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                        <button class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">{{ 'productlist.noproduct'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {# Affichage de la pagination #}
    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>
{% endblock %}