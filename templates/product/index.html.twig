{% extends 'base.html.twig' %}

{% block title %}Nos Produits{% endblock %}

{% block body %}
    <h1 class="my-4 text-center">{{ 'product.title'|trans }}</h1>
    
    <div class="row">
        {% for product in products %}
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    {# Récupération de l'image #}
                    {% set mainImage = product.images|first %}
                    
                    <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #eee;">
                        {% if mainImage %}
                            {# On utilise asset() pour faire le lien correct vers public/ #}
                            <img src="{{ asset(mainImage.url) }}" class="card-img-top" alt="{{ product.name }}" style="width: 100%; height: 100%; object-fit: cover;">
                        {% else %}
                            <span class="text-muted">Pas d'image</span>
                        {% endif %}
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ product.name }}</h5>
                        <p class="card-text">{{ ('product.description.' ~ product.name)|trans }}...</p>
                        
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="h4 mb-0 text-primary">{{ product.price }} €</span>
                            <form action="{{ path('cart_add', {id: product.id}) }}" method="post" class="d-flex align-items-center">
                                <input type="number" name="qty" value="1" min="1" max="100" class="form-control me-2" style="width: 70px;">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-cart-plus"></i> {{ 'cart.add'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">Aucun produit en rayon pour le moment.</div>
            </div>
        {% endfor %}
    </div>
{% endblock %}