{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <div class="row mt-5">
        <div class="col-md-6">
            {# Récupération de la première image #}
            {% set mainImage = product.images|first %}
            {% if mainImage %}
                <img src="{{ mainImage.url }}" class="img-fluid rounded shadow" alt="{{ product.name }}">
            {% else %}
                <img src="https://via.placeholder.com/600x400?text=Pas+d'image" class="img-fluid rounded shadow" alt="Défaut">
            {% endif %}
        </div>
        <div class="col-md-6">
            <h1>{{ product.name }}</h1>
            <hr>
            <p class="lead">{{ product.description }}</p>
            
            <h3 class="my-4 text-primary">{{ product.price }} €</h3>
            
            <p><strong>Catégorie :</strong> {{ product.category.name ?? 'Non classé' }}</p>
            
            <div class="mt-4">
                <a href="{{ path('cart_add', {id: product.id}) }}" class="btn btn-success btn-lg">Ajouter au panier</a>
                <a href="{{ path('product_index') }}" class="btn btn-secondary btn-lg">Retour</a>
            </div>
        </div>
    </div>
{% endblock %}