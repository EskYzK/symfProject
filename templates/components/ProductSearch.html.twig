<div {{ attributes }}>
    <div class="row mb-4 justify-content-center">
        <div class="col-md-6">
            <input 
                type="search" 
                data-model="query" 
                class="form-control form-control-lg" 
                placeholder="{{ 'productpage.search'|trans }}"
                autofocus
            >
        </div>
    </div>

    <div class="row" data-loading="addClass(opacity-50)">
        {% for product in this.products %}
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    {% set mainImage = product.images|first %}
                    
                    <div style="height: 200px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #eee;">
                        {% if mainImage %}
                            <img src="{{ asset(mainImage.url) }}" class="card-img-top" alt="{{ product.name }}" style="width: 100%; height: 100%; object-fit: cover;">
                        {% else %}
                            <span class="text-muted">{{ 'product.no_image'|trans }}</span>
                        {% endif %}
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ product.name }}</h5>
                        <p class="card-text">{{ ('productpage.description.' ~ product.name)|trans|slice(0, 100) }}...</p>
                        
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="h4 mb-0 text-primary">{{ product.price }} €</span>
                            
                            <form action="{{ path('cart_add', {id: product.id}) }}" method="post" class="d-flex align-items-center" data-turbo="false">
                                <input type="number" name="qty" value="1" min="1" max="100" class="form-control me-2" style="width: 70px;">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-cart-plus"></i> {{ 'productpage.add'|trans }}
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center mt-5">
                <div class="alert alert-warning">
                    {{ 'productpage.noresults'|trans({'%query%': query}) }}
                </div>
            </div>
        {% endfor %}
    </div>
</div>