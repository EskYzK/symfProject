<div {{ attributes }}>
    <h3>{{ 'creditcard.add' |trans }}</h3>

    {{ form_start(form, {
        attr: {
            'data-action': 'live#action',
            'data-live-action-param': 'save'
        }
    }) }}
        
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.number) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_row(form.expirationDate) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_row(form.cvv) }}
            </div>
        </div>

        {# CORRECTION : Syntaxe Symfony UX correcte #}
        <button type="submit" class="btn btn-primary" data-loading="addAttribute(disabled)">
            <span data-loading="action(save)|hide">{{ 'creditcard.adding' |trans }}</span>
            <span data-loading="action(save)|show" style="display: none;">
                <span class="spinner-border spinner-border-sm"></span> {{ 'creditcard.validating' |trans }}
            </span>
        </button>

    {{ form_end(form) }}

    <hr class="my-5">

    <h3>{{ 'creditcard.mycards' |trans }}</h3>

    {% if this.cards|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>{{ 'creditcard.card' |trans }}</th>
                        <th>{{ 'creditcard.expirate' |trans }}</th>
                        <th>{{ 'creditcard.actions' |trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for card in this.cards %}
                        <tr>
                            <td>
                                <i class="fas fa-credit-card me-2 text-muted"></i>
                                **** **** **** <strong>{{ card.number|slice(-4) }}</strong>
                            </td>
                            <td>{{ card.expirationDate }}</td>
                            <td>
                                <button 
                                    class="btn btn-sm btn-outline-danger"
                                    data-action="live#action"
                                    data-live-action-param="delete"
                                    data-live-card-param="{{ card.id }}"
                                    onclick="return confirm('Voulez-vous vraiment supprimer cette carte ?')"
                                >
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-light text-center border">
            <p class="text-muted mb-0">{{ 'creditcard.nocard' |trans }}</p>
        </div>
    {% endif %}
</div>